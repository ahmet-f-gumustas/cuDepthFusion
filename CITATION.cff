    family-names: Gümüştaş
    alias: ahmet-f-gumustas
repository-code: "https://github.com/ahmet-f-gumustas/cuDepthFusion"
license: Apache-2.0
version: 0.1.0
date-released: "2026-09-28"
keywords:
  - depth fusion
  - temporal filtering
  - depth denoising
  - RGB-D
  - CUDA
  - robotics
references:
